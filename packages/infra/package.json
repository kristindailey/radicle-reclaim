{
  "name": "infra",
  "version": "0.0.0",
  "private": true,
  "description": "Pulumi TypeScript stack for Reclaim: S3 ingest, Lambda, DynamoDB, AppSync.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "pnpm --filter core build",
    "test": "jest",
    "pretypecheck": "pnpm --filter core build",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm --filter core build",
    "build": "tsc",
    "prebundle": "pnpm --filter core build",
    "bundle": "node scripts/bundle.mjs",
    "preseed": "pnpm --filter infra build",
    "seed": "node dist/src/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@pulumi/aws": "^6.83.4",
    "@pulumi/pulumi": "^3.261.0",
    "core": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "esbuild": "0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.2"
  }
}
