# The deployed AppSync read API the dashboard queries (issue #33).
# Copy to .env.local and fill from the infra stack outputs:
#   VITE_APPSYNC_URL     = pulumi stack output graphqlApiUrl
#   VITE_APPSYNC_API_KEY = pulumi stack output graphqlApiKey --show-secrets
VITE_APPSYNC_URL=
VITE_APPSYNC_API_KEY=
